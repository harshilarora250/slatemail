# Public application URL. Must match the Google OAuth redirect URI in production.
APP_URL=http://localhost:3000
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Create an OAuth 2.0 Web application client in Google Cloud Console.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Generate independent high-entropy secrets (for example: openssl rand -base64 32).
SESSION_SECRET=replace-with-at-least-32-random-bytes
APP_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# Persistent SQLite path; the parent directory is created by the application.
DATABASE_PATH=./data/slatemail.sqlite

# Optional PostHog project settings. These are public project identifiers, not secrets.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_REQUIRES_CONSENT=false

# Email AI is browser-to-local-runtime only. Users may also configure this in Settings.
NEXT_PUBLIC_LOCAL_AI_URL=http://localhost:11434
